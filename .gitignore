# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
firebase-debug.log
firestore-debug.log
pglite-debug.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# e2e (Firebase Emulator Suite)
.e2e-emulator.pid

# env files (can opt-in for committing if needed)
.env*
!.env.example
.mp-integrate-progress.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/

# Design QA: conservar solo las capturas finales y sus comparaciones.
/artifacts/landing-audit/
/artifacts/landing-redesign/*
!/artifacts/landing-redesign/desktop-final.png
!/artifacts/landing-redesign/mobile-final.png
!/artifacts/landing-redesign/comparison-desktop.png
!/artifacts/landing-redesign/comparison-mobile.png
