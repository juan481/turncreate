# Local: correr `npx supabase start` y copiar los valores que imprime
# (o `npx supabase status`) a un .env.local. Son siempre los mismos
# en local (JWT de desarrollo fijos del CLI), no son secretos reales.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Fuera de alcance de la Fase 0 local (ver docs/checklist-cuentas-externas.md) ---
# MERCADOPAGO_APP_ID=
# MERCADOPAGO_APP_SECRET=
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# BREVO_API_KEY=
# SENTRY_DSN=
