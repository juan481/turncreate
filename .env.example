NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Único admin de la consola de plataforma (/platform) -- se compara contra
# el email de la sesión Firebase, no hay tabla de admins.
PLATFORM_ADMIN_EMAIL=
# uid de Firebase Auth del admin: si está, se exige además del email (el registro no verifica emails).
PLATFORM_ADMIN_UID=

# Firebase Admin SDK (solo servidor; nunca exponer al navegador)
FIREBASE_PROJECT_ID=turncreate-prod
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=

# Mercado Pago Marketplace + Checkout Pro (servidor)
MP_APP_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=https://tu-dominio.com/api/integrations/mercadopago/callback
MP_TOKEN_ENCRYPTION_KEY=
MP_WEBHOOK_SECRET=

# HMAC para visitantes Ãºnicos aproximados. Puede ser otra cadena aleatoria.
ANALYTICS_HASH_SECRET=
ANALYTICS_INTERNAL_SECRET=

# --- Integraciones opcionales ---
